# ==============================================================================
# FireSync – Unified Satellite Fire Intelligence (NASA Space Apps Challenge 2026)
# Master Environment Variables
# ==============================================================================

# Express.js Backend Gateway
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Python FastAPI Scientific Processing Service
FASTAPI_PORT=8000
FASTAPI_HOST=127.0.0.1
FASTAPI_SERVICE_URL=http://127.0.0.1:8000
FASTAPI_TIMEOUT_MS=8000

# PostgreSQL + PostGIS Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=firesync_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20

# Frontend Configuration
VITE_API_URL=http://localhost:5000

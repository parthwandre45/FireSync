generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VISITOR
  REGISTERED
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum FireStatus {
  ACTIVE
  CONTAINED
  EXTINGUISHED
  ESTIMATED_CLUSTER
}

enum IngestionStatus {
  SUCCESS
  PARTIAL
  FAILED
  RUNNING
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String          @map("password_hash")
  fullName       String          @map("full_name")
  role           UserRole        @default(REGISTERED)
  status         AccountStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  savedLocations SavedLocation[]
  alertRules     AlertRule[]

  @@map("users")
}

model FireIncident {
  id                 String            @id @default(uuid())
  name               String
  latitude           Float
  longitude          Float
  firstObservedAt    DateTime          @map("first_observed_at")
  lastObservedAt     DateTime          @map("last_observed_at")
  status             FireStatus        @default(ESTIMATED_CLUSTER)
  observationCount   Int               @default(1) @map("observation_count")
  peakFrp            Float?            @map("peak_frp")
  totalFrp           Float?            @map("total_frp")
  estimatedPerimeter Json?             @map("estimated_perimeter")
  region             String?
  metadata           Json?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  observations       FireObservation[]

  @@index([latitude, longitude])
  @@index([status])
  @@index([firstObservedAt, lastObservedAt])
  @@map("fire_incidents")
}

model FireObservation {
  id                String        @id @default(uuid())
  latitude          Float
  longitude         Float
  observationTime   DateTime      @map("observation_time")
  acquisitionDate   DateTime      @map("acquisition_date")
  satellitePlatform String        @map("satellite_platform")
  sensor            String
  confidence        Float
  brightnessTemp    Float?        @map("brightness_temp")
  frp               Float?
  scan              Float?
  track             Float?
  dayNight          String?       @map("day_night")
  sourceDataset     String        @map("source_dataset")
  sourceId          String?       @unique @map("source_id")
  incidentId        String?       @map("incident_id")
  incident          FireIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  ingestedAt        DateTime      @default(now()) @map("ingested_at")
  metadata          Json?

  @@index([latitude, longitude])
  @@index([observationTime])
  @@index([confidence])
  @@index([frp])
  @@index([satellitePlatform])
  @@index([sensor])
  @@map("fire_observations")
}

model SatelliteMission {
  id                  String    @id @default(uuid())
  missionCode         String    @unique @map("mission_code")
  name                String
  satellitePlatform   String    @map("satellite_platform")
  sensor              String
  description         String
  orbitType           String    @map("orbit_type")
  altitudeKm          Float     @map("altitude_km")
  inclinationDeg      Float     @map("inclination_deg")
  spatialResolution   String    @map("spatial_resolution")
  spectralBands       String    @map("spectral_bands")
  swathWidthKm        Float?    @map("swath_width_km")
  overpassTime        String?   @map("overpass_time")
  status              String
  dataSource          String    @map("data_source")
  lastObservationTime DateTime? @map("last_observation_time")
  operationalMetadata Json?     @map("operational_metadata")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("satellite_missions")
}

model SatelliteImageryMetadata {
  id              String   @id @default(uuid())
  layerId         String   @map("layer_id")
  title           String
  sensor          String
  dataset         String
  acquisitionDate DateTime @map("acquisition_date")
  imageryType     String   @map("imagery_type")
  resolution      String?
  format          String   @default("image/png")
  tileMatrixSet   String   @default("GoogleMapsCompatible_Level9") @map("tile_matrix_set")
  wmtsTemplate    String   @map("wmts_template")
  wmsUrl          String?  @map("wms_url")
  attribution     String
  processingInfo  String?  @map("processing_info")
  isAvailable     Boolean  @default(true) @map("is_available")
  boundingBox     Json?    @map("bounding_box")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([layerId])
  @@index([sensor, acquisitionDate])
  @@map("satellite_imagery_metadata")
}

model HistoricalFireStatistics {
  id               String   @id @default(uuid())
  region           String
  periodType       String   @map("period_type")
  startDate        DateTime @map("start_date")
  endDate          DateTime @map("end_date")
  observationCount Int      @map("observation_count")
  averageFrp       Float?   @map("average_frp")
  peakFrp          Float?   @map("peak_frp")
  source           String   @default("NASA_FIRMS_ARCHIVE")
  aggregatedAt     DateTime @default(now()) @map("aggregated_at")

  @@index([region, periodType])
  @@index([startDate, endDate])
  @@map("historical_fire_statistics")
}

model WeatherObservation {
  id              String   @id @default(uuid())
  latitude        Float
  longitude       Float
  temperature     Float?
  humidity        Float?
  windSpeed       Float?   @map("wind_speed")
  windDirection   Float?   @map("wind_direction")
  precipitation   Float?
  airQualityIndex Float?   @map("air_quality_index")
  observationTime DateTime @map("observation_time")
  dataSource      String   @default("Open-Meteo") @map("data_source")
  recordedAt      DateTime @default(now()) @map("recorded_at")

  @@index([latitude, longitude])
  @@index([observationTime])
  @@map("weather_observations")
}

model SavedLocation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  latitude  Float
  longitude Float
  radiusKm  Float    @default(50.0) @map("radius_km")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("saved_locations")
}

model AlertRule {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  latitude        Float?
  longitude       Float?
  radiusKm        Float?    @map("radius_km")
  alertType       String    @default("PROXIMITY") @map("alert_type")
  threshold       Float?
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("alert_rules")
}

model DataIngestionLog {
  id              String          @id @default(uuid())
  source          String
  jobId           String          @map("job_id")
  startTime       DateTime        @map("start_time")
  endTime         DateTime?       @map("end_time")
  recordsReceived Int             @default(0) @map("records_received")
  recordsInserted Int             @default(0) @map("records_inserted")
  recordsUpdated  Int             @default(0) @map("records_updated")
  recordsFailed   Int             @default(0) @map("records_failed")
  status          IngestionStatus @default(RUNNING)
  errorMessage    String?         @map("error_message")
  metadata        Json?

  @@index([source, startTime])
  @@index([status])
  @@map("data_ingestion_logs")
}

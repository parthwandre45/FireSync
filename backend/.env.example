# FireSync Express Gateway Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# NASA FIRMS API Credentials (Keep in Backend Environment Only)
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key
NASA_FIRMS_MAP_KEY=your_firms_map_key_here
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov

# FastAPI Scientific Service Connection
FASTAPI_SERVICE_URL=http://127.0.0.1:8000
FASTAPI_TIMEOUT_MS=8000

# PostgreSQL + PostGIS Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=firesync_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_MAX_CONNECTIONS=20
